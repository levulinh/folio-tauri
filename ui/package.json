    "@types/markdown-it": "^14.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
