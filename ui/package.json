    "@mantine/core": "^9.7.4",
    "@mantine/hooks": "^9.7.4",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "dompurify": "^3.4.17",
    "katex": "0.19.1",
    "lucide-react": "1.64.0",
    "markdown-it": "^14.3.3",
    "papaparse": "5.7.0",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-view": "1.42.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
