{
  "name": "folio-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "VITE_BACKEND=fake vite",
    "dev:e2e": "VITE_BACKEND=fake vite --port 5199 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen": "cd .. && cargo test --workspace export_",
    "tauri": "cd .. && tauri"
  },
  "dependencies": {
    "@blocknote/code-block": "0.56.0",
    "@blocknote/core": "0.56.0",
    "@blocknote/mantine": "0.56.0",
